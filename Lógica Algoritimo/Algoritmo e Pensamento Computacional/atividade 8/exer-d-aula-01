#include <stdio.h>

int main()
{
    int salario[8] = {1};

    for (int i = 1; i < 5; i++)
    {
        printf("Digite o salario %d: ", i);
        scanf("%d", &salario[i]);
    }
    

    for (int i = 1; i < 5; i++)
    {
        printf("Funcionário %d: R$ %d\n", i, salario[i]);
    }

    return 0;
}
