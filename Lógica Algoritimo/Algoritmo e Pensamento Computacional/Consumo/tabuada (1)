#include <stdio.h>

int main()
{
    int numero, i;
    FILE *arquivo;
    
    printf("Digite um  numero inteiro: ");
    scanf("%d", &numero);
    
    arquivo = fopen("tabuada.txt", "w");
    if (arquivo == NULL){
        printf("Não foi possivel criar o arquivo .\n");
        return 1;
    }
    
    for (i=0; i<=10; i++){
        fprintf(arquivo, "%d * %d = %d \n", numero, i, numero * i);
    } 
    
    fclose(arquivo);
    printf("tabuada gravada com sucesso");

    return 0;