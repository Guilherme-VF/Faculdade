#include <stdio.h>

int main()
{
    int idade[7] = {0};

    for (int i = 0; i < 7; i++)
    {
        printf("Digite a idade %d: ", i);
        scanf("%d", &idade[i]);
    }

    for (int i = 0; i < 7; i++)
    {
        printf("Idade %d: %d\n", i, idade[i]);
    }

    return 0;
}